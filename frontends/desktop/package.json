{
  "name": "genericagent-desktop",
  "private": true,
  "version": "0.2.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/write-provenance.mjs",
    "build:tauri-assets": "npm run build && npm run test:dist",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:dist": "node scripts/verify-compiled-dist.mjs",
    "tauri": "tauri",
    "build:dmg": "tauri build --bundles dmg && bash scripts/post-dmg.sh src-tauri/target/release/bundle/dmg/*.dmg"
  },
  "dependencies": {
    "@douyinfe/semi-icons": "^2.71.1",
    "@douyinfe/semi-ui": "^2.71.1",
    "@lobehub/icons": "^5.10.1",
    "@types/prismjs": "^1.26.6",
    "@vscode/codicons": "^0.0.45",
    "katex": "^0.17.0",
    "prismjs": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "happy-dom": "^20.10.6",
    "typescript": "^5.6.3",
    "vite": "^6.0.5",
    "vitest": "^4.1.9"
  }
}
